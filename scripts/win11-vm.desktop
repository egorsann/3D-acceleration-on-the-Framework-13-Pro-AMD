[Desktop Entry]
Type=Application
Name=Windows VM
GenericName=Windows 11 virtual machine (3D)
Comment=Start the Windows 11 VM and open its 3D window (log in at the Windows login screen)
Exec=%HOME%/.local/bin/win11-vm
Icon=win11-vm
Terminal=false
Categories=System;Emulator;
Keywords=windows;vm;win11;
Actions=shutdown;

[Desktop Action shutdown]
Name=Shut down Windows VM
Exec=%HOME%/.local/bin/win11-vm --shutdown
Icon=system-shutdown
