module vgpu3d-venus 1.0;

require {
    type svirt_t;
    class process setpgid;
}

# QEMU (svirt_t) starts virglrenderer's Venus render server and puts it in its own process group.
# Without this the Venus renderer for the 3D virtio-gpu cannot start while SELinux is enforcing.
allow svirt_t self:process setpgid;
